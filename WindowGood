local function makeDraggable(frame, handle)
    handle = handle or frame
    local dragging, dragInput, dragStart, startPos

    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    handle.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            TweenService:Create(frame, TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            }):Play()
        end
    end)
end

-- ANIMASI EXECUTE (RAYFIELD STYLE + FLASHBANG 2 DETIK)
local function playRayfieldExecution(title, author, onComplete)
    local Card = Instance.new("Frame")
    Card.Size = UDim2.new(0, 240, 0, 70)
    Card.Position = UDim2.new(0.5, -120, 0.5, -35)
    Card.BackgroundColor3 = Color3.fromRGB(15, 15, 18)
    Card.BorderSizePixel = 0
    Card.Parent = ScreenGui

    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 10)
    Corner.Parent = Card

    local Stroke = Instance.new("UIStroke")
    Stroke.Color = Color3.fromRGB(255, 255, 255)
    Stroke.Transparency = 0.85
    Stroke.Parent = Card

    -- Spinner Ring
    local Spinner = Instance.new("Frame")
    Spinner.Size = UDim2.new(0, 38, 0, 38)
    Spinner.Position = UDim2.new(0, 15, 0.5, -19)
    Spinner.BackgroundTransparency = 1
    Spinner.Parent = Card

    local RingStroke = Instance.new("UIStroke")
    RingStroke.Thickness = 3
    RingStroke.Color = Color3.fromRGB(255, 255, 255)
    RingStroke.Parent = Spinner

    local RingCorner = Instance.new("UICorner")
    RingCorner.CornerRadius = UDim.new(1, 0)
    RingCorner.Parent = Spinner

    local RingGradient = Instance.new("UIGradient")
    RingGradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(80, 80, 80)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(15, 15, 15))
    })
    RingGradient.Parent = RingStroke

    -- Info Text
    local TitleLbl = Instance.new("TextLabel")
    TitleLbl.Size = UDim2.new(1, -70, 0, 20)
    TitleLbl.Position = UDim2.new(0, 62, 0, 16)
    TitleLbl.BackgroundTransparency = 1
    TitleLbl.Text = title or "GoodManzz Hub"
    TitleLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
    TitleLbl.Font = Enum.Font.GothamBold
    TitleLbl.TextSize = 13
    TitleLbl.TextXAlignment = Enum.TextXAlignment.Left
    TitleLbl.Parent = Card

    local AuthorLbl = Instance.new("TextLabel")
    AuthorLbl.Size = UDim2.new(1, -70, 0, 16)
    AuthorLbl.Position = UDim2.new(0, 62, 0, 36)
    AuthorLbl.BackgroundTransparency = 1
    AuthorLbl.Text = "by: " .. (author or "GoodManzz")
    AuthorLbl.TextColor3 = Color3.fromRGB(160, 160, 170)
    AuthorLbl.Font = Enum.Font.GothamMedium
    AuthorLbl.TextSize = 11
    AuthorLbl.TextXAlignment = Enum.TextXAlignment.Left
    AuthorLbl.Parent = Card

    -- Putaran Spinner (4-5 Detik)
    local duration = 4.5
    local elapsed = 0
    local rotation = 0

    local conn
    conn = RunService.RenderStepped:Connect(function(dt)
        elapsed = elapsed + dt
        local progress = math.clamp(elapsed / duration, 0, 1)
        local speed = 200 + (progress ^ 3) * 2200 
        rotation = rotation + (speed * dt)
        RingGradient.Rotation = rotation % 360

        if elapsed >= duration then
            conn:Disconnect()
            Card:Destroy()

            -- FLASHBANG 2 DETIK
            local Flash = Instance.new("Frame")
            Flash.Size = UDim2.new(1, 0, 1, 0)
            Flash.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            Flash.BackgroundTransparency = 0
            Flash.ZIndex = 999
            Flash.Parent = ScreenGui

            -- Fade out selama 2 detik
            local flashTween = TweenService:Create(Flash, TweenInfo.new(2.0, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                BackgroundTransparency = 1
            })
            flashTween:Play()

            flashTween.Completed:Connect(function()
                Flash:Destroy()
            end)

            if onComplete then onComplete() end
        end
    end)
end

