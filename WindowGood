        ColorSequenceKeypoint.new(0, Color3.fromRGB(20, 20, 24)),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(8, 8, 10)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(0, 0, 0))
